{
  "name": "conatus",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "check:f01": "node scripts/check-f01.mjs",
    "check:f02": "node scripts/check-f02.mjs",
    "check:f03": "node scripts/check-f03.mjs",
    "check:gateway": "node scripts/check-gateway.mjs",
    "check:m1-01": "pnpm check:codex-compatibility && pnpm check:gateway",
    "check:m1-02": "node scripts/check-m1-02.mjs",
    "check:codex-compatibility": "node scripts/check-codex-compatibility.mjs",
    "mac:app": "node scripts/build-mac-app.mjs"
  }
}
